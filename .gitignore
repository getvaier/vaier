
## .gitignore Template
```
# Java
target/
*.class
*.jar
*.war
*.ear
.mvn/
mvnw
mvnw.cmd

# Node
node_modules/
dist/
build/
.npm

# Gradle (the Android app in android/ builds here; build/ above covers its output)
.gradle/

# IDEs
.idea/
.vscode/
*.iml
*.swp

# Environment
.env
*.key
# The credential-vault master key (#307). Covered by *.key above; listed explicitly so it's
# obvious this never gets committed. Lives in the config dir (also ignored via /vaier/ below).
vault.key
*.conf
*.pem

# ...but the SSH key-format fixtures are committed test material, not anybody's key (#350). They exist
# so "which private-key formats does Vaier accept?" is answered by a test rather than by a dependency
# nobody declared. Generated by ssh-keygen purely to be parsed; they authorise nothing, anywhere.
# Narrow on purpose: *.pem still hides every other key in the tree.
!src/test/resources/ssh-keys/*.pem

# ...but the offline fallback page's nginx config is a committed source file, not runtime state.
!offline/default.conf

# Runtime data (secrets, certs, state)
wireguard/
authelia/
traefik/
/vaier/
/geoip/
/icons/
# oauth2-proxy: templates/ are committed sources; config/ is the rendered alpha + client-secret.
oauth2/config/
# dex: config/ is runtime state — the rendered config.yaml plus the upstream/broker secret files.
dex/config/
# CrowdSec (#329): config/ + data/ are the Security Engine's own state (hub cache, sqlite db,
# machine credentials); whitelist/ is the Vaier-rendered trusted-networks allowlist. acquis.d/ is
# NOT listed — it holds the one committed, non-secret acquisition file (traefik.yaml).
crowdsec/config/
crowdsec/data/
crowdsec/whitelist/

# WireGuard
wireguard-config/
wg*.conf

# Docker
docker-compose.override.yml

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code — keep checked-in agents/skills, ignore local/ephemeral state
.claude/settings.local.json
.claude/scheduled_tasks.lock
# A test writes a Traefik config to the literal path "null" when no config dir is set.
/null/

# The served Android app is a build product, never committed
apk/*.apk

# The Windows app (#370): build output, never committed
windows/dist/
windows/**/bin/
windows/**/obj/
