<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only ever used to say that Vaier removed this phone. Refusing it costs the person that one
         message and nothing else: the connection never depended on it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GoBackend's VpnService and its BIND_VPN_SERVICE permission arrive by manifest merge from
         com.wireguard.android:tunnel, so this app declares neither. allowBackup is off on purpose:
         the tunnel's private key is born here and must never leave the device in a backup. -->
    <application
        android:name=".VaierApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vaier">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pull-down shade toggle: connect and disconnect without opening the app. -->
        <service
            android:name=".VaierTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
