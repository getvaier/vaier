<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Vaier.App</RootNamespace>
    <AssemblyName>Vaier</AssemblyName>
    <Version>0.5.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\vaier.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>$(SelfContained)</EnableCompressionInSingleFile>
    <!-- WireGuard's interop predates nullable annotations; it is kept verbatim. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <EmbeddedResource Include="Assets\vaier.ico" LogicalName="vaier.ico" />
    <EmbeddedResource Include="Assets\vaier-off.ico" LogicalName="vaier-off.ico" />
  </ItemGroup>

  <!-- VaierSetup.exe carries WireGuard's two DLLs and writes them out on install; build.sh stages them here. -->
  <ItemGroup Condition="'$(VaierNativeDir)' != ''">
    <EmbeddedResource Include="$(VaierNativeDir)tunnel.dll" LogicalName="tunnel.dll" />
    <EmbeddedResource Include="$(VaierNativeDir)wireguard.dll" LogicalName="wireguard.dll" />
    <EmbeddedResource Include="$(VaierNativeDir)wireguard-nt-LICENSE.txt" LogicalName="wireguard-nt-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaier.Core\Vaier.Core.csproj" />
  </ItemGroup>

</Project>
